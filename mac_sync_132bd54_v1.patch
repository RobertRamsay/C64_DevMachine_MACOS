diff --git a/C64Devmachine/scripts/scr_panel_help_wf_sprites/scr_panel_help_wf_sprites.gml b/C64Devmachine/scripts/scr_panel_help_wf_sprites/scr_panel_help_wf_sprites.gml
new file mode 100644
index 0000000..cbf32df
--- /dev/null
+++ b/C64Devmachine/scripts/scr_panel_help_wf_sprites/scr_panel_help_wf_sprites.gml
@@ -0,0 +1,45 @@
+/// WORKFLOW tour steps for: SPRITE_SET, SPRITE_MASK, ANIMATION, CHAR_SET
+/// (see scr_panel_help_workflow for the format)
+function scr_panel_help_wf_sprites() {
+    return {
+        SPRITE_SET : [
+            { title: "A BANK OF SPRITES", text: "A sprite set is a bank of up to 64 C64 sprites, each 24x21 pixels and 64 bytes.\n\nA hires sprite has one colour of its own. A multicolour sprite is 12x21 double-wide pixels in three colours: its own plus two shared by all sprites.", targets: [] },
+            { title: "BRING SPRITES IN", text: "IMPORT loads SPRED64 text (.txt), .spr, SpritePad .spd or raw .bin files, replacing this set. A raw binary has no colours, so defaults are used until you pick your own.\n\nIMPORT PNG reads a picture as a grid of 24x21 frames and shows a confirm panel before anything changes.", targets: ["IMPORT", "IMPORT PNG"] },
+            { title: "OR START FROM SCRATCH", text: "This panel shows every sprite in the set. Click the + cell to add a blank sprite, or click any sprite to open the editor on it.", targets: ["+"] },
+            { title: "OPEN THE SPRITE EDITOR", text: "EDIT SPRITES opens the built-in editor. You work on a copy: the same button becomes CLOSE (COMMIT EDITS), which writes everything back to the asset.\n\nOn the left is the slot picker - click a slot to edit it, SHIFT or CTRL + click to select several, CTRL+C / CTRL+V to copy and paste.", targets: ["EDIT SPRITES"] },
+            { title: "MODE AND COLOURS", text: "The mode button switches a sprite between hires and multicolour (ALL -> MC / ALL -> HR does the whole bank).\n\nAbove the palette, pick what to paint with: UC is this sprite's own colour, MC1 and MC2 are shared by every multicolour sprite, BG sits behind them all. Then click a palette colour to set it.", targets: ["@PALETTE"] },
+            { title: "PAINT THE SPRITE", text: "On the canvas, left drag paints and right drag erases. Middle drag or SPACE + drag shifts the sprite, wrapping at the edges. CTRL+Z undoes.\n\nThe tool row has FLIPX, FLIPY, ROT90, CLEAR, plus FILL and LINE for flood fills and straight lines.", targets: [] },
+            { title: "BUILD BIGGER OBJECTS", text: "Below the canvas is the compositor. Pick a slot and click a grid square to place it; BASE and L1-L7 are layers, higher ones on top. Click a placement to nudge or expand it, right click to remove it.\n\nEach placement becomes one hardware sprite - the C64 has eight per line.", targets: [] },
+            { title: "ANIMATE IT", text: "Each frame holds its own placements. + NEW adds a frame, DUP copies the current one, and A / D step between frames.\n\nPLAY previews the animation; FWD, REV, PNG (ping-pong) and ONCE set the direction, and START, END and FPS set the range and speed.", targets: [] },
+            { title: "CONVERT TO NODES", text: "CONVERT TO NODES, at the bottom of the compositor, makes SPRITE nodes for the current frame - and an ANIMATE node when two or more frames are in range (max 8 placements per frame).\n\nJSR the show routine once, then the animate routine every frame after a VWAIT. A message gives you the names.", targets: [] },
+            { title: "COMMIT AND EXPORT", text: "Finish with CLOSE (COMMIT EDITS) - the project keeps the sprites and your source file is never overwritten. Autosave covers the rest.\n\nEXPORT SPRED64, EXPORT BIN and EXPORT SPD save copies for other tools.", targets: ["EXPORT SPRED64", "EXPORT BIN", "EXPORT SPD"] }
+        ],
+        SPRITE_MASK : [
+            { title: "WHAT A SPRITE MASK DOES", text: "A sprite mask lets sprites walk behind parts of a bitmap scene - a pillar, a tree, a wall in front.\n\nYou paint the foreground over the bitmap, and on the C64 those pixels are cut out of the sprite, 8x8 cell by cell.", targets: [] },
+            { title: "PICK THE PICTURE", text: "Choose the bitmap to paint over from the REFERENCE BITMAP list on the right. Click a name to use it; the wheel scrolls the list.", targets: [] },
