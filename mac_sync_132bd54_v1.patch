+/// @function scr_asset_bmp_commit_edit(_asset)
+/// @desc Leave bitmap edit mode and commit: encode + save to disk, rebuild the
+///       canvas from the saved bytes (so it shows what the file holds), and
+///       refresh every node thumbnail that shows this bitmap. Used by the EDIT
+///       toggle, RETURN TO BITMAP BUILDER and by obj_asset_manager Step when
+///       the viewer is closed or moved to another asset mid-edit, whatever
+///       AUTO-CLEAN is set to.
+function scr_asset_bmp_commit_edit(_asset) {
+    gpu_set_texfilter(true);
+    // A new bitmap that was never drawn on has no file yet; leave it that
+    // way rather than writing an empty .kla.
+    var _untouched = (_asset.file == "" || !file_exists(_asset.file))
+                  && !(variable_struct_exists(_asset.meta, "bmp_unsaved") && _asset.meta.bmp_unsaved);
+    if (_untouched) {
+        _asset.meta.is_editing = false;
+        _asset.meta.dirty_timer = -1;
+        _asset.meta.last_px = undefined;
+        _asset.meta.last_py = undefined;
+        return;
+    }
+    if (scr_asset_kla_save(_asset)) {
+        scr_asset_bmp_build_preview(_asset);
+        if (variable_struct_exists(_asset.meta, "preview_surf") && surface_exists(_asset.meta.preview_surf)) {
+            if (!buffer_exists(_asset.meta.pixel_backup)) {
+                _asset.meta.pixel_backup = buffer_create(320 * 200 * 4, buffer_fixed, 1);
+            }
+            buffer_get_surface(_asset.meta.pixel_backup, _asset.meta.preview_surf, 0);
+        }
+    }
+    _asset.meta.bmp_unsaved = false;
+    _asset.meta.has_data    = true;
+    _asset.meta.is_editing  = false;
+    _asset.meta.dirty_timer = -1;
+    _asset.meta.last_px     = undefined;
+    _asset.meta.last_py     = undefined;
+    var _name = _asset.name;
+    var _file = _asset.file;
+    with (all) {
+        if (variable_instance_exists(id, "instructions")) {
+            if (is_array(instructions) && array_length(instructions) > 0
+            &&  is_array(instructions[0]) && array_length(instructions[0]) > 1
+            &&  string(instructions[0][1]) == _name) {
+                if (variable_instance_exists(id, "kla_filename")) kla_filename = filename_name(_file);
+                if (variable_instance_exists(id, "preview_surf")) {
+                    if (surface_exists(preview_surf)) surface_free(preview_surf);
+                    preview_surf = -1;
+                }
+            }
+        }
+    }
+    global.undo_dirty = true;
+}
diff --git a/C64Devmachine/scripts/scr_asset_panel_reorder/scr_asset_panel_reorder.gml b/C64Devmachine/scripts/scr_asset_panel_reorder/scr_asset_panel_reorder.gml
new file mode 100644
index 0000000..2872bb4
--- /dev/null
+++ b/C64Devmachine/scripts/scr_asset_panel_reorder/scr_asset_panel_reorder.gml
@@ -0,0 +1,36 @@
+/// @function scr_asset_panel_reorder(_drag_idx, _target_idx, _after)
+/// @desc Asset panel drag-and-drop between rows. Moves asset _drag_idx to sit
+///       just before (or, with _after, just after) asset _target_idx, joins
+///       the target's group, and switches the panel to the OWN sort so the
+///       hand-made order is what shows. The order starts from whatever the
+///       panel showed (NAME / TYPE / ADDR / OWN), so nothing else jumps.
+///       Only the panel order changes: asset_list indices, addresses and the
+///       build are untouched.
+function scr_asset_panel_reorder(_drag_idx, _target_idx, _after) {
+    with (obj_asset_manager) {
+        if (_drag_idx == _target_idx) return;
+        var _seq = scr_asset_sorted_indices();
+        var _from = -1;
+        for (var _i = 0; _i < array_length(_seq); _i++) {
+            if (_seq[_i] == _drag_idx) { _from = _i; break; }
+        }
+        if (_from < 0) return;
+        array_delete(_seq, _from, 1);
+        var _to = -1;
+        for (var _j = 0; _j < array_length(_seq); _j++) {
+            if (_seq[_j] == _target_idx) { _to = _j; break; }
+        }
+        if (_to < 0) return;
+        if (_after) _to += 1;
+        array_insert(_seq, _to, _drag_idx);
+        for (var _k = 0; _k < array_length(_seq); _k++) {
+            ds_list_find_value(asset_list, _seq[_k]).order = _k;
+        }
+        var _moved  = ds_list_find_value(asset_list, _drag_idx);
+        var _target = ds_list_find_value(asset_list, _target_idx);
+        _moved.group = variable_struct_exists(_target, "group") ? _target.group : "";
+        asset_sort_mode       = "OWN";
+        global.undo_dirty     = true;
+        global.autosave_dirty = true;
+    }
+}
