+            { title: "USE IT IN NODES", text: "Add a SPRITE MASK node, choose this asset as its SOURCE, list the sprite slots to mask and set HOT Y to the sprite's feet.\n\nJSR its routine once per frame, after moving and animating. The mask autosaves with the project.", targets: [] }
+        ],
+        ANIMATION : [
+            { title: "WHAT AN ANIMATION IS", text: "An animation holds named sequences - WALK, JUMP, IDLE - played by one routine. Each step says which sprite to show on each layer.\n\nANIM SET nodes use it; SELECT and ALIAS stay on each node, so several nodes can share one animation.", targets: [] },
+            { title: "CHOOSE THE SPRITE BANK", text: "Use the < and > buttons on the SPRITE BANK row to pick the sprite set the frames come from. Its sprites fill the grid at the bottom.", targets: ["SPRITE BANK:*"] },
+            { title: "ROWS ARE SEQUENCES", text: "Each row is one sequence. < and > on the top row move between rows, click the name to rename it, + ROW and - ROW add and delete.\n\nDELAY is how many 50 Hz frames each step lasts - lower is faster. LOOP off stops on the last step, for one-shot moves.", targets: ["+ ROW", "- ROW", "DELAY*", "LOOP"] },
