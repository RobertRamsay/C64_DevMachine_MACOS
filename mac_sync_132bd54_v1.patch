diff --git a/C64Devmachine/scripts/scr_panel_help_wf_bitmaps/scr_panel_help_wf_bitmaps.gml b/C64Devmachine/scripts/scr_panel_help_wf_bitmaps/scr_panel_help_wf_bitmaps.gml
new file mode 100644
index 0000000..17c5c5d
--- /dev/null
+++ b/C64Devmachine/scripts/scr_panel_help_wf_bitmaps/scr_panel_help_wf_bitmaps.gml
@@ -0,0 +1,47 @@
+/// WORKFLOW tour steps for: BITMAP, VECTOR_BITMAP, BITMAP_BUILDER, BMP_OBJECTS
+/// (see scr_panel_help_workflow for the format)
+function scr_panel_help_wf_bitmaps() {
+    return {
+        BITMAP : [
+            { title: "A FULL C64 PICTURE", text: "A BITMAP is one full 320x200 C64 screen picture, stored as a Koala Paint .kla file.\n\nOpening it drops you straight into the editor. A new bitmap starts as a blank canvas, ready to paint on or to import art into.", targets: ["@LARGEST"] },
+            { title: "MULTICOLOUR OR HIRES", text: "Multicolour is 160x200 with double-wide pixels: each 8x8 cell can show 4 colours, one of them the background shared by the whole picture.\n\nHires is 320x200 with thin pixels but only 2 colours per cell. Click to switch; most C64 game screens use multicolour.", targets: ["MC MODE", "HIRES"] },
+            { title: "BRING ART IN", text: "IMPORT loads a Koala .kla file, or a PNG. A PNG opens the importer: use the sliders on the right to place and adjust the picture and the dither buttons on the left, then CONFIRM IMPORT (or CANCEL).\n\nLater, BACK TO IMPORT reopens the importer with your last settings so you can tweak and confirm again.", targets: ["IMPORT"] },
+            { title: "PICK YOUR COLOURS", text: "Choose colours from the 16-colour palette beside the tools: left-click sets the main pen colour (marked 1), right-click the second colour (marked 2). Alt+click on the canvas picks a colour from the picture.\n\nIn multicolour, BG: sets the background colour shared by every cell.", targets: ["@PALETTE", "BG:"] },
+            { title: "DRAWING TOOLS", text: "DRAW is a freehand brush ([ and ] change its size, Shift+click draws a line). LINE, CIRCLE and RECT are dragged out on the canvas; click CIRCLE or RECT again to toggle filled or outline. FILL flood-fills and GRADIENT blends colour 1 into colour 2.\n\nIn multicolour, the right button erases to the background.", targets: ["DRAW", "LINE", "CIRCLE*", "RECT*", "FILL", "GRADIENT"] },
+            { title: "DITHER AND STAMPS", text: "The dither list on the right makes any tool paint only a pattern of pixels, for hand shading. NONE paints solid.\n\nGRAB copies a box of the picture as a stamp brush; FLIP X and FLIP Y mirror it, or the whole bitmap when you have no stamp.", targets: ["NONE", "GRAB", "FLIP X", "FLIP Y"] },
+            { title: "ZOOM AND CELL GRID", text: "Z+ and Z- zoom the canvas (or use the mouse wheel); pan with middle mouse or space and drag.\n\nCELL GRID outlines every 8x8 colour cell, so you can see where the C64 colour limits apply.", targets: ["Z+", "Z-", "CELL GRID:*"] },
+            { title: "COLOUR CLASH", text: "The C64 can only show a few colours in each 8x8 cell; paint too many and the cell clashes.\n\nWith CLEAN:ON clashes are fixed as soon as you lift the pen. Turn it OFF to sketch freely, then press CLEANUP (or Backspace) to force every cell back within its limit. CLEANUP flashes when clashes are waiting.", targets: ["CLEAN:*", "CLEANUP"] },
+            { title: "UNDO AND CLEAR", text: "Ctrl+Z undoes your last stroke or action, so experiment freely.\n\nCLEAR wipes the whole picture to the background colour; that can be undone too.", targets: ["CLEAR"] },
+            { title: "SAVING", text: "The bitmap autosaves shortly after each stroke and again when you close the editor.\n\nRESAVE (orange when there are unsaved changes) or SAVE in the title bar forces a save right now. PREVIEW shows the whole picture at 1:1, and EXPORT PNG / EXPORT KLA save copies for other tools.", targets: ["RESAVE", "SAVE", "PREVIEW"] },
+            { title: "USE IT IN YOUR PROGRAM", text: "To show the picture, add a BITMAP node to your program and pick this asset: it sets up VIC bitmap mode and loads the picture's data. USED BY lists the nodes using it.\n\nThe SPRITES panel can also add hardware sprites over the picture, and SETUP NODES builds a ready-made program that shows it all.", targets: ["USED BY:", "SETUP NODES"] }
+        ],
+        VECTOR_BITMAP : [
+            { title: "PICTURES AS COMMANDS", text: "A VECTOR_BITMAP stores a picture as a list of drawing commands (lines, boxes, ellipses, fills) instead of pixels. The C64 redraws it at run time, so a whole screen costs only a few hundred bytes.\n\nOnly the outlined 192x120 window in the middle of the canvas can be drawn on.", targets: ["@LARGEST"] },
+            { title: "PICK COLOURS", text: "Each page has four colour slots, shown as swatches beside the tools: slot 0 is the background, slots 1-3 are drawing colours.\n\nLeft-click a slot to draw with it; right-click to change which C64 colour it holds. Everything drawn with that slot changes with it.", targets: ["@PALETTE"] },
+            { title: "DRAW SHAPES", text: "Pick a tool on the right: PLOT for single pixels, LINE, RECT and RECTFILL, ELLIPSE and ELLIPSEFILL. Drag from start to end on the canvas and release to commit.\n\nFILL flood-fills an area, with an optional dither for extra shades.", targets: ["PLOT", "LINE", "RECT", "RECTFILL", "ELLIPSE", "ELLIPSEFILL", "FILL"] },
+            { title: "EXTRA COLOUR AND COPIES", text: "Colours on the C64 are set per 8x8 cell. RECOL_C and RECOL_S recolour the cells you drag over, so a page can show more than four colours.\n\nCOPYRGN copies a block of cells elsewhere as one cheap command, great for repeating bricks or windows. GRID shows the cells.", targets: ["RECOL_C", "RECOL_S", "COPYRGN", "GRID:*"] },
+            { title: "COMMANDS AND UNDO", text: "The list on the far right shows every command on this page with its byte cost, plus the total for all pages. X on a row deletes it.\n\nUNDO LAST removes the newest command; CLEAR deletes the whole page without asking.", targets: ["UNDO LAST", "CLEAR"] },
+            { title: "PAGES", text: "One asset can hold several pages, such as every room of an adventure. < and > step between pages, +ADD adds a blank page and DEL removes the current one.\n\nYour work is kept with the project; EXPORT VBM and IMPORT VBM move it between projects as a .vbm file.", targets: ["<", ">", "+ADD", "EXPORT VBM"] },
+            { title: "SHOW IT ON THE C64", text: "Add a VECTOR BMP node to set up the drawing runtime and draw this asset; VECTOR PAGE nodes flip to other pages by number.\n\nThe C64 draws with its own routines, so the result may differ slightly from this preview where colours clash.", targets: [] }
+        ],
+        BITMAP_BUILDER : [
+            { title: "BUILD SCREENS FROM TILES", text: "A BITMAP_BUILDER assembles screens from blocks of a tile-sheet bitmap. Each block you place is a small copy record, and the C64 replays them at run time, so many screens can share one sheet.", targets: [] },
+            { title: "PICK SOURCE AND DEST", text: "SRC BMP picks the BITMAP used as the tile sheet. DST BMP picks the BITMAP the blocks are placed onto.\n\nThe right-hand panel is only a preview: the real destination is not changed unless you BAKE. EDIT SOURCE opens the sheet in the bitmap editor.", targets: ["SRC BMP:", "DST BMP:", "EDIT SOURCE"] },
+            { title: "GRAB AND PLACE", text: "Drag a rectangle of cells on the SOURCE sheet (left). Then click on the DEST preview to stamp it; it repeats, so keep clicking to lay down rows of floor or wall.\n\nRight-click cancels. BLEND: SOLID copies opaquely, MASK 00 lets the background colour show the destination through.", targets: ["@LARGEST", "SOLID", "MASK 00"] },
+            { title: "RECORDS AND GROUPS", text: "Every stamp adds a record to the list on the right; reorder with UP and DOWN, delete with X, and Ctrl+Z undoes.\n\nRecords are split into groups, usually one per screen. The GROUP ID arrows step between them and + ADD starts a new one.", targets: ["UP", "DOWN", "GROUP ID:", "+ ADD"] },
+            { title: "COLLISION TAGS", text: "TAG ON lets you paint collision types onto the source sheet. Tags travel with every grab of that cell, so a wall tile is solid wherever you place it. SHOW TAGS overlays them on the preview.", targets: ["TAG ON", "TAG OFF", "SHOW TAGS*", "HIDE TAGS*"] },
+            { title: "GENERATE THE TABLE", text: "GENERATE BBD creates the data table the game reads. After that it shows BBD AUTO and updates itself whenever you change the records, so there is nothing else to save.\n\nBAKE -> DEST is optional: it writes the preview into the real destination bitmap.", targets: ["GENERATE BBD", "BBD AUTO", "BAKE -> DEST"] },
+            { title: "USE IT IN YOUR PROGRAM", text: "Add a MOVE BMP BLK node in ASSET mode, point it at the generated table and set its entry var to the group number to draw that screen.\n\nThe reminder line under the controls lists the node settings to match this builder.", targets: [] }
+        ],
+        BMP_OBJECTS : [
+            { title: "SOFTWARE SPRITES", text: "BMP OBJECTS are software sprites: graphics plus a mask that your game draws into a bitmap screen. The mask cuts a hole, the graphics fill it, and the background shows round the edges.\n\nThey can be any size, with no per-line limit.", targets: [] },
+            { title: "MATCH YOUR BITMAP", text: "First set the mode to match the bitmap they will be drawn on: HIRES has one ink colour and thin pixels, MULTICOLOUR has three colours and fat pixel pairs. Click to switch.", targets: ["HIRES", "MULTICOLOUR"] },
+            { title: "ADD AN OBJECT", text: "+ NEW adds a blank object (type its size in cells, like 3,3). IMPORT PNG makes one from an image, and GRAB FROM BITMAP cuts one out of a BITMAP asset.\n\nClick an object in the PARTS list or the sheet to edit it.", targets: ["+ NEW", "IMPORT PNG", "GRAB FROM BITMAP", "PARTS*"] },
+            { title: "PICK COLOURS", text: "The colour swatches at the top (INK and PAPER, or BG, C1, C2, C3 in multicolour) set the colours objects are drawn with. Click to step through the C64 colours.\n\nUnder the canvas, choose the pen to paint with: a colour, MASK or ERASE.", targets: ["INK", "PAPER", "PEN"] },
+            { title: "PAINT IT", text: "Left mouse paints with the pen, Shift+left paints mask (solid, hides the background) and right mouse erases to see-through. Ctrl+Z undoes.\n\nThe COMPOSITE layer shows graphics and mask together, as the game draws them, and is the best layer to work in.", targets: ["EDIT*", "COMPOSITE"] },
+            { title: "QUICK MASKS", text: "AUTO builds the mask from the graphics with a 1-pixel outline, the classic black border round a C64 character. = INK masks exactly the drawn pixels with no outline.", targets: ["AUTO", "= INK"] },
+            { title: "SAVED AS YOU GO", text: "Every change goes straight into the asset's data and is kept with the project; UNDO and REDO cover them all. RENAME, RESIZE and DELETE tidy up your objects.", targets: ["UNDO", "REDO", "RENAME"] },
+            { title: "DRAW THEM IN YOUR GAME", text: "Add a BMP OBJECT node (MACROS 1). Pick this asset, an object number and the COL and ROW to draw at; both can come from variables.\n\nMODE: DRAW just draws, and MOVE restores the background and redraws at the new place each frame, for a moving object.", targets: [] }
+        ]
+    };
+}
diff --git a/C64Devmachine/scripts/scr_panel_help_wf_bitmaps/scr_panel_help_wf_bitmaps.yy b/C64Devmachine/scripts/scr_panel_help_wf_bitmaps/scr_panel_help_wf_bitmaps.yy
