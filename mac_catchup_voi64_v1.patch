diff --git a/C64Devmachine/scripts/scr_voi64_text_to_phonemes/scr_voi64_text_to_phonemes.gml b/C64Devmachine/scripts/scr_voi64_text_to_phonemes/scr_voi64_text_to_phonemes.gml
