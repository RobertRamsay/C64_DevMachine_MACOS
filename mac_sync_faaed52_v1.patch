n_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 480.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "HOW IT STARTS\nSYSTEM INIT is empty; the JMP below it goes to BL_BOOT ($0820), which\nswitches BASIC out and jumps to BOOT_MAIN ($A000). BOOT_MAIN copies\nLOW_CODE, SOUND_DRIVER and CHECK_PAGE into place, sets the values the\noriginal loader leaves behind ($02 = $32 is checked - the game wipes zero\npage without it) and starts the game at $0400.\n\nEDITING\nTiles: BL_TILES_A-D. Each char is drawn with every pixel row doubled\n(TILE_EXPAND), so a tile looks squashed in the editor - that is right.\nRooms 0-9 use TILES_A, 10-17 and 19 use TILES_B, 18 uses TILES_C\n(ROOM_DRAW sets $F2); TILES_D is expanded to $B800.\nCode blocks: keep each block ending where it started. .byte lines are\ninstructions the Dev Machine assembler would encode differently."]], "binary_blob": ""}, {"x": 860.0, "y": 880.0, "type": "MACRO_CODE", "params": [], "custom_title": "", "stable_uid": 100041.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "HOOKS (MUSIC + JOYSTICK)", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 52602.0, "pc_address": 52480.0, "height": 100.0, "title": "Code Block", "connected": true, "org_parent_x": 860.0, "org_parent_y": 800.0, "has_org_parent": true, "code": [["code_block", "; BRUCE LEE - MUSIC HOOKS  ($CD00, a page the game never touches)\n; The title tune is the Music Maker asset BL_MUSIC, played by the SID SONG\n; node at $F200. Two entries of the SOUND_DRIVER jump table point here:\n;   $E003  jmp MUS_START  (the title screen starts its tune: LOW_CODE $06DA)\n;   $E006  jmp MUS_PLAY   (the title IRQ, once a frame: $154C)\n; Only the jump table changed - the game checksums its own code, so the\n; calls themselves stay original. The rest of SOUND_DRIVER still plays the\n; in-game music and sound effects.\n; The game uses most of zero page, so the player's 44 ZP bytes ($50-$7B)\n; are swapped with MUS_ZP around every call.\nMUS_START:\n    jsr $e306                    ; original driver start (its tune is no longer played)\n    jsr MUS_SWAP\n    lda #$00                     ; song 0 = TITLE\n    tax                          ; from its first order row\n    jsr sng100100_seek\n    lda #$0f\n    sta $d418                    ; SID volume\n    jmp MUS_SWAP\n\nMUS_PLAY:\n    jsr MUS_SWAP\n    jsr sng100100_play\nMUS_SWAP:\n    ldx #$2b\nMUS_SWAP_L:\n    lda $50,x\n    pha\n    lda MUS_ZP,x\n    sta $50,x\n    pla\n    sta MUS_ZP,x\n    dex\n    bpl MUS_SWAP_L\n    rts\n\n; ---- JOYSTICK ----\n; The original reads one fixed port per player. With one human playing\n; (F5 = COMPUTER) either joystick port now controls Bruce Lee; with two\n; humans at once (F5 = OPPONENT, $42CA set) each keeps its original port.\n; Called from PLAYER_INPUT $16A2 / $16A9 / $16C4 and $1A1B.\nJOY_DIR:\n    lda $42ca                    ; two humans on the sticks at once?\n    bne JOY_DIR_P1\nJOY_BOTH:\n    lda $dc00                    ; CIA1 port A (joy 2)\n    and $dc01                    ; CIA1 port B (joy 1) - either stick\n    rts\nJOY_DIR_P1:\n    lda $dc01                    ; original: port 1\n    rts\nJOY_DIR_B:\n    lda $42ca\n    beq JOY_BOTH\n    lda $dc00                    ; original: port 2\n    rts\nJOY_FIRE:\n    lda $42ca\n    beq JOY_BOTH\n    lda $dc00,x                  ; original: X picks the port\n    rts\n\nMUS_ZP:\n    .byte $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00\n    .byte $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00\n    .byte $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00\n"]], "binary_blob": ""}, {"x": 160.0, "y": 1100.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 100004.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 220.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "ROOMS - BL_ROOMS (MAP_DATA, export RLE STREAM)\n21 rooms of 40 x 11 tiles, 7 across x 3 down, numbered left to right\n(room 20 is room 19 again, as in the original table). ROOM_DRAW reads\nthe asset's lo / hi tables at $68F9 / $690E, so keep the map there.\nEach tile is 8 x 16 on screen: TILE_EXPAND doubles every row of the\n8 x 8 tile into two chars (top half N, bottom half N+128).\nColour BLACK = the game's dark cells (bit 7, colour RAM $F8).\nROOM VIEW (meta room_view): each room is shown with the charset and\ncolour bands the game uses (TILES_A rooms 0-9, B 10-17/19/20, C 18;\nbands from $480B / $4833). Top panel STAMPS / ROOM PREVIEW [G]: the room\nthe game's way, < > rooms, its charset and colour bands editable;\n[H] Y x2, [T] tag badges."]], "binary_blob": ""}, {"x": 860.0, "y": 1120.0, "type": "MACRO_SID_SONG", "params": [], "custom_title": "", "stable_uid": 100100.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 65335.0, "pc_address": 61952.0, "height": 140.0, "title": "SID SONG", "connected": true, "org_parent_x": 860.0, "org_parent_y": 1040.0, "has_org_parent": true, "code": [["macro_sid_song", "BL_MUSIC", 0.0, 80.0, 0.0, 0.0, 0.0]], "binary_blob": ""}, {"x": 160.0, "y": 1340.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 100003.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 300.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "TITLE MUSIC\nBL_MUSIC (Music Maker) is the title tune, rebuilt note for note from the\noriginal driver: song TITLE, 2 frames a row, BASS / LEAD / LEAD SOFT.\nEdit it in Music Maker and rebuild - the SID SONG at $F200 plays it.\nThe SOUND_DRIVER jump table sends $E003 (title start) and $E006 (title\nframe) to MUS_START / MUS_PLAY at $CD00; in-game sound is untouched.\nBUILD: PRG EXO - the image reaches past $D000, which a plain PRG load\nwould write over the I/O chips."]], "binary_blob": ""}, {"x": 160.0, "y": 1680.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 100101.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 260.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "SPRITES - BL_SPRITES_1 / _2 / _3 (SPRITE_SET, export STRIPS)\nThe game keeps its frames as strips 1 or 2 bytes wide (hires, shown\nX-expanded in game) and copies them into the sprite buffers at $8180\nevery frame. Each asset sprite is one strip, drawn in its top-left\ncorner; the build writes it back to its origina