-{"code_editor_font_index": 1.0, "kernal_unlocked": true, "basic_unlocked": true, "nodes": [{"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.4, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "binary_blob": "", "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "x": 160, "y": 0, "type": "COMMENT", "title": "COMMENT", "connected": false, "height": 600.0, "code": [["Comment", "BRUCE LEE (Datasoft 1984, Ron J. Fortier) - 1:1 port from the Remember crack\nEvery game byte is the original at its original address; the crack intro,\ntrainer and packers are gone.\n\nMEMORY\n$0400-$08FF  LOW_CODE      start-up, title IRQ   (stored in BOOT, copied)\n$0900-$68F8  ENGINE / GAME CODE / GFX + TABLES\n$68F9-$817F  BL_ROOMS      the 20 rooms (pointers $4B34 lo / $4B49 hi)\n$8180-$83FF  sprite buffers (filled every frame)\n$8680-$87FF  BL_MENU_FONT  big DATASOFT / BRUCE LEE letters\n$8800-$8FFF  status font (built from ROM) + screen $8C00\n$9000-$9FFF  BL_TILES_A-D  room tiles, 128 MC chars each\n$A000-$BFFF  charsets built by TILE_EXPAND (each tile -> 2 chars)\n$CF00        CHECK_PAGE    (stored in BOOT, copied)\n$E000-$F1FF  SOUND_DRIVER  music + effects (stored in BOOT, copied)\nVIC bank 2: screen $8C00, room charset $A000/$A800/$B000 ($F2 -> $D018)"]], "stable_uid": 100001.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.4, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "binary_blob": "", "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "x": 160, "y": 640, "type": "COMMENT", "title": "COMMENT", "connected": false, "height": 420.0, "code": [["Comment", "HOW IT STARTS\nSYSTEM INIT is empty; the JMP below it goes to BL_BOOT ($0820), which\nswitches BASIC out and jumps to BOOT_MAIN ($A000). BOOT_MAIN copies\nLOW_CODE, SOUND_DRIVER and CHECK_PAGE into place, sets the values the\noriginal loader leaves behind ($02 = $32 is checked - the game wipes zero\npage without it) and starts the game at $0400.\n\nEDITING\nTiles: BL_TILES_A-D. Each char is drawn with every pixel row doubled\n(TILE_EXPAND), so a tile looks squashed in the editor - that is right.\nRooms 0-9 use TILES_A, 10-17 and 19 use TILES_B, 18 uses TILES_C\n(ROOM_DRAW sets $F2); TILES_D is expanded to $B800.\nCode blocks: keep each block ending where it started. .byte lines are\ninstructions the Dev Machine assembler would encode differently."]], "stable_uid": 100002.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.4, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "binary_blob": "", "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "x": 160, "y": 1100, "type": "COMMENT", "title": "COMMENT", "connected": false, "height": 300.0, "code": [["Comment", "ROOMS - BL_ROOMS (byte data for now)\nEach room is a 40 x 11 grid of tile numbers, packed:\n  n < $80      repeat the next tile n times\n  $80 + n      n tiles follow as they are\n  $80          end of room\nA tile with bit 7 set gets colour RAM $F8. Every cell is drawn as the\ntile (top) and tile + $80 (bottom half) one row below."]], "stable_uid": 100003.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2062.0, "pc_address": 2062.0, "binary_blob": "", "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "x": 860.0, "y": 60.0, "type": "INIT", "title": "SYSTEM INIT", "connected": true, "height": 80.0, "code": [], "stable_uid": 100004.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2065.0, "pc_address": 2062.0, "binary_blob": "", "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "x": 860.0, "y": 140.0, "type": "NORMAL", "title": "JMP", "connected": true, "height": 60.0, "code": [["jmp_abs", "BL_BOOT"]], "stable_uid": 100005.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": 10.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": false, "collapsed": false, "end_address": 2088.0, "pc_address": 2080.0, "binary_blob": "", "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "x": 860.0, "y": 260.0, "type": "ORG", "title": "ORG BLOCK", "connected": false, "height": 80.0, "code": [["nop", 0.0]], "stable_uid": 100006.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2080.0, "pc_address": 2080.0, "binary_blob": "", "org_parent_x": 860.0, "org_parent_y": 260.0, "has_org_parent": true, "x": 860.0, "y": 340.0, "type": "LABEL", "title": "ADDRESS LABEL", "connected": true, "height": 40.0, "code": [["label", "BL_BOOT"]], "stable_uid": 100007.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "BOOT STEP 1", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2088.0, "pc_address": 2080.0, "binary_blob": "", "org_parent_x": 860.0, "org_parent_y": 260.0, "has_org_parent": true, "x": 860.0, "y": 380.0, "type": "MACRO_CODE", "title": "Code Block", "connected": true, "height": 100.0, "code": [["code_block", "; BRUCE LEE - BOOT STEP 1  ($0820)\n; $A000 is under BASIC ROM at RUN time, so switch BASIC out first.\n; (this area is overwritten by LOW_CODE once BOOT_MAIN runs)\n    sei\n    lda #$36\n    sta $01                      ; CPU port: RAM at $A000, I/O + KERNAL\n    jmp BOOT_MAIN\n"]], "stable_uid": 100008.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": 11.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": false, "collapsed": false, "end_address": 47318.0, "pc_address": 40960.0, "binary_blob": "", "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "x": 860.0, "y": 500.0, "type": "ORG", "title": "ORG BLOCK", "connected": false, "height": 80.0, "code": [["nop", 0.0]], "stable_uid": 100009.0}, {"custom_title": "", "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "BOOT + PACKED PARTS", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 47318.0, "pc_address": 40960.0, "binary_blob": "", "org_parent_x": 860.0, "org_parent_y": 500.0, "has_org_parent": true, "x": 860.0, "y": 580.0, "type": "MACRO_CODE", "title": "Code Block", "connected": true, "height": 100.0, "code": [["code_block", "; BRUCE LEE - BOOT  ($A000)\n; The crack (Remember) packed three pieces of the game that cannot be built in place:\n;   $0400-$08FF  LOW_CODE   start-up + room/IRQ code that sits on the default screen\n;   $E000-$F1FF  SOUND_DRIVER  music + sound effects driver under the KERNAL\n;   $CF00-$CFFF  CHECK_PAGE    table DISK_CHECK ($512F) waits on ($CF8F/$CFAF = $B9)\n; They are stored here ($A000+ is rebuilt by TILE_EXPAND later, so this space is free\n; once the game runs) and copied into place with interrupts off, then the game starts\n; at $0400 exactly as the original loader left it.\nBOOT_MAIN:\n    sei\n    lda #$34\n    sta $01                      ; CPU port: all RAM\n    ldx #$02\n    lda #$00\nBOOT_ZP:\n    sta $00,x                    ; zero page $02-$FF = 0 (as the loader left it)\n    inx\n    bne BOOT_ZP\n    ldx #$cc\nBOOT_P3:\n    dex\n    sta $0334,x                  ; $0334-$03FF = 0 ($03FF = first-boot flag)\n    bne BOOT_P3\n; the values the original loader leaves behind - the game checks them\n; ($02 must be $32, or it wipes zero page from $1709 on)\n    lda #$32\n    sta $02                      ; loader signature\n    lda #$01\n    sta $cc                      ; cursor off\n    sta $0313\n    sta $0318                    ; NMI vector lo\n    sta $ba                      ; last device\n    lda #$40\n    sta $0301\n    lda #$03\n    sta $0319                    ; NMI vector hi\n    lda #$00\n    sta $0302                    ; BASIC warm start lo\n    sta $bb\n    lda #$04\n    sta $0303                    ; BASIC warm start hi\n    lda #$00\n    sta $fb\n    lda #$c0\n    sta $fc\n    ldy #$00\n    tya\nBOOT_CLR:\n    sta ($fb),y                  ; $C000-$FFFF = 0 (work RAM the game expects clear)\n    iny\n    bne BOOT_CLR\n    inc $fc\n    bne BOOT_CLR\n    lda #<LOW_CODE\n    sta $fb\n    lda #>LOW_CODE\n    sta $fc\n    lda #$04\n    ldx #$05\n    jsr BOOT_COPY                ; LOW_CODE -> $0400-$08FF\n    lda #<SOUND_DRIVER\n    sta $fb\n    lda #>SOUND_DRIVER\n    sta $fc\n    lda #$e0\n    ldx #$12\n    jsr BOOT_COPY                ; SOUND_DRIVER -> $E000-$F1FF\n    lda #<CHECK_PAGE\n    sta $fb\n    lda #>CHECK_PAGE\n    sta $fc\n    lda #$cf\n    ldx #$01\n    jsr BOOT_COPY                ; CHECK_PAGE -> $CF00\n    lda #<NMI_RTI\n    sta $fffa                    ; NMI vector\n    sta $fffc                    ; RESET vector\n    lda #>NMI_RTI\n    sta $fffb\n    sta $fffd\n    lda #<IRQ_ENTRY\n    sta $fffe                    ; IRQ vector\n    lda #>IRQ_ENTRY\n    sta $ffff\n    lda #$36\n    sta $01                      ; CPU port: I/O + KERNAL\n    ldx #$00\n    lda #$06\nBOOT_COL:\n    sta $d800,x                  ; colour RAM = blue\n    sta $d900,x\n    sta $da00,x\n    sta $db00,x\n    inx\n    bne BOOT_COL\n    sta $d020                    ; border\n    sta $d021                    ; background\n    lda $d011                    ; VIC control 1\n    and #$0f\n    sta $d011                    ; screen off\n    jmp $0400                    ; LOW_CODE entry (copied above)\n\n; copy X pages from ($FB) to page A\nBOOT_COPY:\n    sta $fe\n    lda #$00\n    sta $fd\n    ldy #$00\nBOOT_COPY_L:\n    lda ($fb),y\n    sta ($fd),y\n    iny\n    bne BOOT_COPY_L\n    inc $fc\n    inc $fe\n    dex\n    bne BOOT_COPY_L\n    rts\n\n; ---- LOW_CODE: runs at $0400-$08FF (listing in the comments) ----\nLOW_CODE:\n    .byte $78                 ; 0400  sei \n    .byte $d8                 ; 0401  cld \n    .byte $a2, $ff            ; 0402  ldx #$ff\n    .byte $9a                 ; 0404  txs \n    .byte $ad, $11, $d0       ; 0405  lda $d011  VIC control 1\n    .byte $29, $ef            ; 0408  and #$ef\n    .byte $8d, $11, $d0       ; 040a  sta $d011  VIC control 1\n    .byte $ad, $ff, $03       ; 040d  lda $03ff\n    .byte $f0, $03            ; 0410  beq $0415\n    .byte $4c, $d1, $04       ; 0412  jmp $04d1\n    .byte $a9, $00            ; 0415  lda #$00\n    .byte $8d, $00, $eb       ; 0417  sta $eb00\n    .byte $8d, $70, $ef       ; 041a  sta $ef70\n    .byte $8d, $70, $f0       ; 041d  sta $f070\n    .byte $8d, $1b, $d4       ; 0420  sta $d41b  SID osc 3\n    .byte $a9, $ff            ; 0423  lda #$ff\n    .byte $8d, $0f, $d4       ; 0425  sta $d40f  SID v3 freq hi\n    .byte $8d, $0e, $d4       ; 0428  sta $d40e  SID v3 freq lo\n    .byte $a9, $80            ; 042b  lda #$80\n    .byte $8d, $12, $d4       ; 042d  sta $d412  SID v3 control\n    .byte $a2, $00            ; 0430  ldx #$00\n    .byte $a0, $60            ; 0432  ldy #$60\n    .byte $88                 ; 0434  dey \n    .byte $d0, $fd            ; 0435  bne $0434\n    .byte $ad, $1b, $d4       ; 0437  lda $d41b  SID osc 3\n    .byte $9d, $00, $02       ; 043a  sta $0200,x\n    .byte $e8                 ; 043d  inx \n    .byte $d0, $f2            ; 043e  bne $0432\n    .byte $ea                 ; 0440  nop \n    .byte $ea                 ; 0441  nop \n    .byte $ea                 ; 0442  nop \n    .byte $a9, $32            ; 0443  lda #$32\n    .byte $85, $01            ; 0445  sta $01\n    .byte $a2, $00            ; 0447  ldx #$00\n    .byte $bd, $00, $d0       ; 0449  lda $d000,x  sprite 0 X\n    .byte $9d, $00, $89       ; 044c  sta $8900,x\n    .byte $49, $ff            ; 044f  eor #$ff\n    .byte $9d, $00, $8b       ; 0451  sta $8b00,x\n    .byte $bd, $00, $d1       ; 0454  lda $d100,x\n    .byte $9d, $00, $88       ; 0457  sta $8800,x\n    .byte $49, $ff            ; 045a  eor #$ff\n    .byte $9d, $00, $8a       ; 045c  sta $8a00,x\n    .byte $e8                 ; 045f  inx \n    .byte $d0, $e7            ; 0460  bne $0449\n    .byte $a9, $36            ; 0462  lda #$36\n    .byte $85, $01            ; 0464  sta $01\n    .byte $a2, $07            ; 0466  ldx #$07\n    .byte $a9, $ff            ; 0468  lda #$ff\n    .byte $9d, $00, $89       ; 046a  sta $8900,x\n    .byte $a9, $03            ; 046d  lda #$03\n    .byte $9d, $10, $8a       ; 046f  sta $8a10,x\n    .byte $a9, $c0            ; 0472  lda #$c0\n    .byte $9d, $b0, $8a       ; 0474  sta $8ab0,x\n    .byte $ca                 ; 0477  de