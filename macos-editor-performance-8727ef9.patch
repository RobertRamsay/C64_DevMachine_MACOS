+    scr_undo_snapshot();
+    global.undo_dirty = false;
+    if (!editor_release_panning && !is_panning && global.autosave_mode != 3) {
+        var _was_clean = !global.autosave_dirty;
+        global.autosave_dirty = true;
+        global.manual_saved = false;
