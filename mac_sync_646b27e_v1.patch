+    array_push(_list, ["label",   _p + "rdone"]);
+    array_push(_list, ["lda_lab", _p + "any",      _id]);
+    array_push(_list, ["bne",     _p + "build",    _id]);
+    array_push(_list, ["jmp_abs", _p + "restore",  _id]);   // nothing masked under the sprite
+
+    // ── Build the 21-line mask ──
