+        }
+        var _sy2 = _ry + 18;
+        for (var _si = 0; _si < _slots; _si++) {
+            var _bx1 = _draw_x + 4 + _si * (_box_w + _box_gap);
+            if (point_in_rectangle(mouse_x, mouse_y, _bx1, _sy2, _bx1 + _box_w, _sy2 + 14)) {
