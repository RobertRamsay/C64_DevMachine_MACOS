+        draw_surface_part_ext(_surf, 256 + _gx, _gy, 8, 8, _x, _y, _sx, _sy, _mc2, 1);
+        draw_surface_part_ext(_surf, 384 + _gx, _gy, 8, 8, _x, _y, _sx, _sy, _fg,  1);
