+
+            case SREL.ANC: _a = _a & _v; _as = -1; _p = (_p & ~0x83) | (_a & 0x80) | (real(_a == 0) * 2) | ((_a >> 7) & 1); break;
+            case SREL.ALR: {
+                _a = _a & _v;
+                _p = (_p & ~1) | (_a & 1);
+                _a = _a >> 1; _as = -1;
+                _p = (_p & ~0x82) | (_a & 0x80) | (real(_a == 0) * 2);
+            } break;
+            case SREL.ARR: {
+                _a = _a & _v;
+                var _c1 = _p & 1;
+                _p = (_p & ~1) | (_a & 1);
