+            case SREL.JMP: _pc = _opw; break;
+            case SREL.JSR: {
+                var _ret = (_cur + 2) & 0xFFFF;
+                _m[0x100 + _sp] = (_ret >> 8) & 0xFF; _s[0x100 + _sp] = -2; _sp = (_sp - 1) & 0xFF;
+                _m[0x100 + _sp] = _ret & 0xFF;        _s[0x100 + _sp] = -2; _sp = (_sp - 1) & 0xFF;
