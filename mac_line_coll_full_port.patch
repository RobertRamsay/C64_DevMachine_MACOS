diff --git a/C64Devmachine/scripts/scr_node_step_macro_coll_line/scr_node_step_macro_coll_line.gml b/C64Devmachine/scripts/scr_node_step_macro_coll_line/scr_node_step_macro_coll_line.gml
new file mode 100644
index 0000000..03092f0
--- /dev/null
