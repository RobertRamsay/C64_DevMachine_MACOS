+/// ====================================================================
+function scr_pickup_default() {
+    return {
+        map: "", auto: true, tiles: [], repl: [],
+        fields: ["FLAG", "REPL", "X", "Y"], flag: 1, x_off: 0, y_off: 0,
+        index: 0, term: 255, empty: [], rooms: [], orig: []
