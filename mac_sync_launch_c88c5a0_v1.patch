+        return undefined;
+    }
+    if (string_copy(_k, 1, 9) == "LASTTYPE:") {
+        _n = scr_tour_last_by_type(string_delete(_k, 1, 9));
+        if (_n != noone) {
+            return scr_tour_node_rect(_n);
+        }
+        return undefined;
+    }
+    if (_k == "FREELABEL") {
+        _n = scr_tour_free_label();
