 0.0]], "binary_blob": ""}, {"x": 160.0, "y": 0.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 100001.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 2.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 580.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "BRUCE LEE (Datasoft 1984, Ron J. Fortier) - 1:1 port from the Remember crack\nEvery game byte is the original at its original address; the crack intro,\ntrainer and packers are gone.\n\nMEMORY\n$0400-$08FF  LOW_CODE      start-up, title IRQ   (stored in BOOT, copied)\n$0900-$5D90  ENGINE / GAME CODE / GFX + TABLES\n$5730-       BL_LANTERNS   lantern lists per room (PICKUP_TABLE, from BL_ROOMS)\n$5D91-$68F8  BL_SPRITES_1-3  fighter + object frames (sprite STRIPS)\n$68F9-       BL_ROOMS      21 rooms: lo table, hi table, streams (map, RLE STREAM)\n$8180-$83FF  sprite buffers (filled every frame)\n$8400-$87FF  BL_MENU_FONT  title letters: BRUCE LEE + DATASOFT PRESENTS\n$8800-$8FFF  status font (built from ROM) + screen $8C00\n$9000-$9FFF  BL_TILES_A-D  room tiles, 128 MC chars each\n$A000-$BFFF  charsets built by TILE_EXPAND (each tile -> 2 chars)\n$CD00        HOOKS         title tune -> BL_MUSIC; either joystick port\n$CF00        CHECK_PAGE    (stored in BOOT, copied)\n$E000-$F1FF  SOUND_DRIVER  in-game music + effects (stored in BOOT, copied)\n$F200-       SID SONG      plays BL_MUSIC on the title screen\nVIC bank 2: screen $8C00, room charset $A000/$A800/$B000 ($F2 -> $D018)"]], "binary_blob": ""}, {"x": 860.0, "y": 40.0, "type": "INIT", "params": [], "custom_title": "", "stable_uid": 100005.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2062.0, "pc_address": 2062.0, "height": 80.0, "title": "SYSTEM INIT", "connected": true, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [], "binary_blob": ""}, {"x": 860.0, "y": 120.0, "type": "NORMAL", "params": [], "custom_title": "", "stable_uid": 100006.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "Code Block", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2065.0, "pc_address": 2062.0, "height": 60.0, "title": "JMP", "connected": true, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["jmp_abs", "BL_BOOT"]], "binary_blob": ""}, {"x": 1700.0, "y": 160.0, "type": "MACRO_CODE", "params": [], "custom_title": "", "stable_uid": 100017.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "GAME CODE $1984", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 8844.0, "pc_address": 6532.0, "height": 100.0, "title": "Code Block", "connected": true, "org_parent_x": 1700.0, "org_parent_y": 80.0, "has_org_parent": true, "code": [["code_block", "; BRUCE LEE - GAME CODE  ($1984-$228B)\n; original bytes at their original addresses\n\n; ---- GAME_LOGIC30 ----\nGAME_LOGIC30:\n    and #$0f\n    asl\n    asl\n    adc #$34\n    ora #$80\n    sta ($04),y\n    clc\n    adc #$01\n    sta ($06),y\n    clc\n    adc #$01\n    iny\n    sta ($04),y\n    clc\n    adc #$01\n    sta ($06),y\n    rts\n\n; ---- GAME_LOGIC31 ----\nGAME_LOGIC31:\n    lda #$00\n    sta $43bb\n    clc\n    rol $43bc\n    rol $43bb\n    rol $43bc\n    rol $43bb\n    rol $43bc\n    rol 