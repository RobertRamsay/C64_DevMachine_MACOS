+    var _n  = noone;
+
+    if (_kind == "SPRITE") {
+        _n = scr_tour_spine_macro("MACRO_SPR", _st);
+        _n.instructions[0][1] = "SHIP";
+        _n.instructions[0][2] = 0;
+        _n.instructions[0][3] = 172;
+        _n.instructions[0][4] = 150;
+    }
+    if (_kind == "COLLIDE") {
+        _n = scr_tour_spine_macro("MACRO_SPR", _st);
+        _n.instructions[0][1] = "SHIP";
+        _n.instructions[0][2] = 0;
+        _n.instructions[0][3] = 100;
+        _n.instructions[0][4] = 150;
+        _n = scr_tour_spine_macro("MACRO_SPR", _st);
+        _n.instructions[0][1] = "SHIP";
+        _n.instructions[0][2] = 1;
+        _n.instructions[0][3] = 220;
+        _n.instructions[0][4] = 150;
