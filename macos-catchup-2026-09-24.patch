 title fine-scroll ($D016 shadow)\n    sta $d016                ; VIC control 2\n    jmp $ea81                ; KERNAL IRQ exit\nZ_21E6:\n    lda #$b7\n    sta $d016                ; VIC control 2\n    sta $02a8                ; title fine-scroll ($D016 shadow)\n    ldx #$00\nZ_21F0:\n    nop\n    lda $0681,x\n    sta $0680,x\n    lda $06a9,x\n    sta $06a8,x\n    lda $06d1,x\n    sta $06d0,x\n    lda $06f9,x\n    sta $06f8,x\n    lda $0721,x\n    sta $0720,x\n    lda $0749,x\n    sta $0748,x\n    lda $0771,x\n    sta $0770,x\n    lda $0799,x\n    sta $0798,x\n    lda $07c1,x\n    sta $07c0,x\n    inx\n    cpx #$27\n    bne Z_21F0\n    inc $02a9                ; title scroll column index\n    ldx $02a9                ; title scroll column index\n    lda $1400,x              ; scroll text row 0 (256 cols)\n    sta $06a7\n    lda $1500,x              ; scroll text row 1\n    sta $06cf\n    lda $1600,x              ; scroll text row 2\n    sta $06f7\n    lda $1700,x              ; scroll text row 3\n    sta $071f\n    lda $1800,x              ; scroll text row 4\n    sta $0747\n    lda $1900,x              ; scroll text row 5\n    sta $076f\n    lda $1a00,x              ; scroll text row 6\n    sta $0797\n    lda $1b00,x              ; scroll text row 7\n    sta $07bf\n    lda $1c00,x              ; scroll text row 8\n    sta $07e7\n    jmp $ea81                ; KERNAL IRQ exit\n    .byte $a9,$00,$8d,$a9,$02                                          ; $226B\n\n; --- IRQ exit (shared)\nZ_2270:\n    jmp $ea81                ; KERNAL IRQ exit\n; $2273 MADE BY text\n    .byte $0d,$01,$04,$05,$20,$02,$19,$00                              ; $2273\n\n; --- INSTRUCTIONS SCREEN (not called by any code path found - kept for completeness)\nZ_227B:\n    nop\n    lda #$c7\n    sta $d016                ; VIC control 2\n    lda #$16\n    sta $d018                ; VIC memory ptrs\n    lda #$00\n    sta $d015                ; sprite enable\n    lda #$16\n    sta $d018                ; VIC memory ptrs\n    lda #$9e\n    jsr $ffd2                ; KERNAL CHROUT\n    jsr $e544                ; KERNAL clear screen\n    lda #$0a\n    sta $d020                ; border\n    sta $d021                ; background\n    ldx #$00\nZ_22A2:\n    lda $22c7,x              ; instructions text\n    sta $049e,x\n    inx\n    cpx #$78\n    bne Z_22A2\n    lda #$00\n    sta $0340                ; title sprite colour table (6)\n    ldx #$00\n    ldy #$00\nZ_22B6:\n    inx\n    bne Z_22B6\n    iny\n    bne Z_22B6\n    inc $0340                ; title sprite colour table (6)\n    lda $0340                ; title sprite colour table (6)\n    cmp #$11\n    bne Z_22B6\n    rts\n; $22C7 instructions text\n    .byte $20,$20,$20,$20,$20,$40,$40,$40,$40,$20,$20,$43,$0f,$0c,$0c,$05 ; $22C7\n    .byte $03,$14,$20,$14,$08,$05,$20,$33,$39,$20,$20,$0b,$05,$19,$13,$20\n    .byte $20,$40,$40,$40,$40,$20,$20,$20,$20,$20,$20,$40,$40,$40,$20,$01\n    .byte $0e,$04,$20,$06,$09,$0e,$04,$20,$14,$08,$05,$20,$05,$18,$09,$14\n    .byte $20,$14,$0f,$20,$06,$12,$05,$05,$04,$0f,$0d,$20,$40,$40,$40,$20\n    .byte $20,$20,$20,$20,$20,$20,$40,$40,$40,$40,$40,$40,$40,$40,$40,$40\n    .byte $40,$40,$40,$40,$40,$40,$40,$40,$40,$40,$40,$40,$40,$40,$40,$40\n    .byte $40,$40,$40,$40,$20,$20,$20,$20"]],"binary_blob":""},{"x":1180.0,"y":160.0,"type":"MACRO_CODE","custom_title":"","stable_uid":100016.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"ENDING $1000","scroll_alias":"","anim_alias":"","helper_text":"","x_indent":0.0,"proxy":true,"collapsed":false,"end_address":4286.0,"pc_address":4096.0,"height":100.0,"title":"Code Block","connected":true,"org_parent_x":1180.0,"org_parent_y":80.0,"has_org_parent":true,"code":[["code_block","; ZYRON'S ESCAPE - ENDING $1000  ($1000-$10BD)\n; ported 1:1 from the original binary - addresses are the original ones\n;\n\n; --- ENDING SEQUENCE - called when all 39 keys are taken ($CAC3=1). Shows a VIC bank 3 bitmap\n; at $E000\/$F000 for ~51 delay loops with the tune playing. NOTE: this crack image ends at $DFFF,\n; so the picture data is not present - the screen shows whatever is in RAM there.\nZ_1000:\n    lda #$36\n    sta $01                  ; CPU port\n    sei\n    lda #$46\n    sta $0314                ; IRQ vector lo\n    lda #$10\n    sta $0315                ; IRQ vector hi\n    lda #$7f\n    sta $dc0d                ; CIA1 IRQ control\n    lda #$01\n    sta $d01a                ; VIC IRQ mask\n    lda #$1b\n    sta $d011                ; VIC control 1\n    lda #$00\n    sta $d012                ; raster\n    nop\n    nop\n    nop\n    lda #$0f\n    sta $d418                ; SID volume\n    cli\n    ldx #$00\n    ldy #$00\n    sty $02\nZ_1032:\n    inx\n    bne Z_1032\n    iny\n    bne Z_1032\n    inc $02\n    lda $02\n    cmp #$33\n    bne Z_1032\n    lda #$00\n    sta $d418                ; SID volume\n    rts\n\n; --- ENDING IRQ - raster splits at 0 \/ $8C \/ $C7, bank 3, bitmap mode\nZ_1046:\n    lda #$01\n    sta $d019                ; VIC IRQ flags\n    lda $d012                ; raster\n    cmp #$00\n    beq Z_105D\n    cmp #$8c\n    beq Z_1094\n    cmp #$c7\n    beq Z_10A9\n    jmp Z_10BB\nZ_105D:\n    lda #$8c\n    sta $d012                ; raster\n    lda $dd02                ; CIA2 DDR A\n    ora #$03\n    sta $dd02                ; CIA2 DDR A\n    lda $dd00                ; CIA2 port A (VIC bank)\n    and #$fc\n    sta $dd00                ; CIA2 port A (VIC bank)\n    lda $d018                ; VIC memory ptrs\n    and #$0f\n    ora #$c0\n    sta $d018                ; VIC memory ptrs\n    lda $d018                ; VIC memory ptrs\n    and #$f0\n    ora #$08\n    sta $d018                ; VIC memory ptrs\n    lda #$3b\n    sta $d011                ; VIC control 1\n    sta $d020                ; border\n    nop\n    nop\n    nop\n    jmp Z_10BB\nZ_1094:\n    lda #$04\n    sta $d020                ; border\n    sta $d021                ; background\n  