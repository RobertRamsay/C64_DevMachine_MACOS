Unused",0],[24,"Unused",0],[16,"Unused",0],[1,"JoyUp",1],[2,"JoyDown",1],[4,"JoyLeft",1],[8,"JoyRight",1],[255,"Unused",0]],"binary_blob":"","custom_title":"","stable_uid":271724,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Input","scroll_alias":""},{"anim_alias":"","x":1960,"helper_text":"","y":660,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":39583.0,"type":"MACRO_CODE","pc_address":39424.0,"height":100,"title":"CODE BLOCK","connected":true,"org_parent_x":1960,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; JOYSTICK / FIRE\n; Port 2 selects callbacks. Diagonals combine moves. Fire uses an edge latch.\n; State used here:\n;   $C000: player X\n;   $C001: player Y\n;   $C004: shot active flag\n;   $C005: shot X\n;   $C006: shot Y\n\n; $F8 is the active-low joystick sample stored by the JOYSTICK macro.\n; $C00B is an edge latch: hold fire without retriggering the sound.\nLDA $F8\nSTA $C00C\n; Fire is tested after movement, including diagonal movement.\nLDA $F8\nAND #$10\nBNE FireReleased\nLDA $C00B\nBNE InputDone\nLDA #$01\nSTA $C00B\nLDA $C004\nBNE InputDone\nLDA #$01\nSTA $C004\nLDA $C000\nCLC\nADC #$00\nSTA $C005\nLDA $C001\nSEC\nSBC #$08\nSTA $C006\nJSR FireSound\nRTS\n\n; Clear the latch so the next press can fire again.\nFireReleased:\nLDA #$00\nSTA $C00B\n\n; Return to the caller after processing the current input.\nInputDone:\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":271725,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Fire button","scroll_alias":""},{"anim_alias":"","x":1960,"helper_text":"","y":760,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":39583.0,"type":"LABEL","pc_address":39424.0,"height":40,"title":"ADDRESS LABEL","connected":true,"org_parent_x":1960,"org_parent_y":340,"has_org_parent":true,"code":[["label","JoyUpRight"]],"binary_blob":"