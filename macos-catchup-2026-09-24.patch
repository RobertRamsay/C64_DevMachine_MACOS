:[["code_block","; ZYRON'S ESCAPE - ZE_KEYS ($CC00)  added by the port, not in the original game\n; The original RESET WORLD wrote tile $33 back at 39 hard-coded addresses, so the keys\n; could not be moved. Now the map is scanned once at boot (KEY_SCAN, called from the\n; START block) and every $33 tile found is remembered here. RESET WORLD calls\n; KEY_RESTORE, the panel calls KEY_DIGITS. Paint keys anywhere in ZE_WORLD_MAP\n; (up to 64 of them) and the game follows.\n;\n; ZP $2F\/$30 is reused as the pointer - the game only uses it inside the key pickup\n; ($C51F), which never runs at the same time as these routines.\n    jmp KEY_SCAN                 ; $CC00\n    jmp KEY_RESTORE              ; $CC03\n    jmp KEY_DIGITS               ; $CC06\n\n; --- KEY_SCAN: walk the map $4000-$99FF, record every $33 (one page per row, so\n;     row = high byte, column = low byte)\nKEY_SCAN:\n    lda #$00\n    sta KEY_COUNT\n    sta $2f\n    lda #$40\n    sta $30\n    ldy #$00\nKS_LOOP:\n    lda ($2f),y\n    cmp #$33\n    bne KS_NEXT\n    ldx KEY_COUNT\n    cpx #$40                     ; table holds 64 keys\n    bcs KS_NEXT\n    tya\n    sta KEY_LO,x\n    lda $30\n    sta KEY_HI,x\n    inc KEY_COUNT\nKS_NEXT:\n    iny\n    bne KS_LOOP\n    inc $30\n    lda $30\n    cmp #$9a                     ; end of map (row 90)\n    bne KS_LOOP\n    rts\n\n; --- KEY_RESTORE: put every recorded key back and reset the keys-remaining count\nKEY_RESTORE:\n    ldx KEY_COUNT\n    stx $cac0                    ; keys remaining\n    beq KR_DONE\nKR_LOOP:\n    dex\n    lda KEY_LO,x\n    sta $2f\n    lda KEY_HI,x\n    sta $30\n    ldy #$00\n    lda #$33\n    sta ($2f),y\n    cpx #$00\n    bne KR_LOOP\nKR_DONE:\n    rts\n\n; --- KEY_DIGITS: KEYS REMAINING nn on the panel, screen codes $B0-$B9\nKEY_DIGITS:\n    lda KEY_COUNT\n    jmp hud100033_KEYS           ; HUD field KEYS: two digits at $0668, screen codes $B0-$B9\n\nKEY_COUNT:\n    .byte $00\nKEY_LO:\n    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00\nKEY_HI:\n    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00\n"]],"binary_blob":""}],"boxes":[{"box_col_idx":2.0,"x":820.0,"box_name":"LOAD + START","box_h":220.0,"y":40.0,"box_w":260.0},{"box_col_idx":4.0,"x":1140.0,"box_name":"GAME CODE (original addresses)","box_h":420.0,"y":40.0,"box_w":1040.0},{"box_col_idx":0.0,"x":1140.0,"box_name":"ENGINE","box_h":460.0,"y":500.0,"box_w":1320.0}],"assets":[{"linked_assets":[],"reu_used":0.0,"reu_size":0.0,"reu_filename":"","d64_filename":"","type":"BYTE_DATA","load_later":false,"blob":"b64:","file":"","name":"ZE_TITLE_TOP","address":4286.0,"meta":{"bmp_mode":"MC","ecm_bg3":3.0,"byte_string":"$20, $4D, $31, $00, $0C, $11, $FA, $05, $4C, $44, $41, $20, $56, $AA, $31, $36\n$3A, $B0, $41, $20, $23, $31, $3A, $53, $54, $41, $20, $56, $AA, $31, $36, $3A\n$4D, $32, $20, $49, $4E, $43, $20, $56, $3A, $49, $4E, $43, $20, $56, $3A, $4A\n$53, $52, $20, $50, $41, $55, $53, $45, $3A, $4C, $44, $41, $20, $56, $3A, $43\n$4D, $50, $20, $23, $36, $34, $3A, $42, $4E, $45, $20, $4D, $32, $00, $45, $11\n$04, $06, $4D, $33, $20, $44, $45, $43, $20, $56, $3A, $44, $45, $43, $20, $56\n$3A, $44, $45, $43, $20, $56, $AA, $31, $3A, $4A, $53, $52, $20, $50, $41, $55\n$53, $45, $3A, $4C, $44, $41, $20, $56, $3A, $43, $4D, $50, $20, $23, $30, $3A\n$42, $4E, $45, $20, $4D, $33, $00, $8B, $11, $0E, $06, $4C, $44, $41, $20, $56\n$AA, $31, $36, $3A, $AF, $20, $23, $32, $35, $34, $3A, $53, $54, $41, $20, $56\n$AA, $31, $36, $3A, $4D, $34, $20, $44, $45, $43, $20, $56, $3A, $44, $45, $43\n$20, $56, $3A, $44, $45, $43, $20, $56, $AA, $3