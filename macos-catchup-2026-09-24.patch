xels per frame, with the original playfield limit.\n; The joystick macro calls this label; RTS returns to its dispatcher.\nLDA $C000\nCMP #$EE\nBCS JoyRightDone\nINC $C000\nINC $C000\nJoyRightDone:\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":271741,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Move Right","scroll_alias":""},{"anim_alias":"","x":1960,"helper_text":"","y":1680,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":39583.0,"type":"LABEL","pc_address":39424.0,"height":40,"title":"ADDRESS LABEL","connected":true,"org_parent_x":1960,"org_parent_y":340,"has_org_parent":true,"code":[["label","JoyUp"]],"binary_blob":"","custom_title":"","stable_uid":271742,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Input","scroll_alias":""},{"anim_alias":"","x":1960,"helper_text":"","y":1720,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":39583.0,"type":"MACRO_CODE","pc_address":39424.0,"height":100,"title":"CODE BLOCK","connected":true,"org_parent_x":1960,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; JOYSTICK / FIRE\n; Port 2 selects callbacks. Diagonals combine moves. Fire uses an edge latch.\n; State used here:\n;   $C001: player Y\n\n; Move two pixels per frame, with the original playfield limit.\n; The joystick macro calls this label; RTS returns to its dispatcher.\nLDA $C001\nCMP #$54\nBCC JoyUpDone\nDEC $C001\nDEC $C001\nJoyUpDone:\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":271743,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Move Up","scroll_alias":""},{"anim_alias":"","x":1960,"helper_text":"","y":1820,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":39583.0,"type":"LABEL","pc_address":39424.0,"height":40,"title":"ADDRESS LABEL","connected":true,"org_parent_x":1960,"org_parent_y":340,"has_org_parent":true,"code":[["label","JoyDown"]],"binary_blob":"","custom_title":"","stable_uid":271744,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Input","scroll_alias":""},{"anim_alias":"","x":1960,"helper_text":"","y":1860,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":39583.0,"type":"MACRO_CODE","pc_address":39424.0,"height":100,"title":"CODE BLOCK","connected":true,"org_parent_x":1960,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; JOYSTICK / FIRE\n; Port 2 selects callbacks. Diagonals combine moves. Fire uses an edge latch.\n; State used here:\n;   $C001: player Y\n\n; Move two pixels per frame, with the original playfield limit.\n; The joystick macro calls this label; RTS returns to its dispatcher.\nLDA $C001\nCMP #$DA\nBCS JoyDownDone\nINC $C001\nINC $C001\nJoyDownDone:\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":271745,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Move Down","scroll_alias":""},{"anim_alias":"","x":2280,"helper_text":"","y":160,"comment_w_mult":1,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":2062.0,"type":"COMMENT","pc_address":256.0,"height":100,"title":"ATTACK WAVES","connected":false,"org_parent_x":-1,"org_parent_y":-1,"has_org_parent":false,"code":[["Comment","Read WAVE_SCRIPT rows.\nChoose path and spacing.\nAdvance active enemies."]],"binary_blob":"","custom_title":"ATTACK WAVES","stable_uid":271759,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":2280,"helper_text":"","y":340,"comment_w_mult":1.0,"x_indent":0.0,"proxy":false,"collapsed":true,"end_address":43265.0,"type":"ORG","pc_address":43008.0,"height":80.0,"title":"ORG BLOCK","connected":false,"org_parent_x":-1.0,"org_parent_y":-1.0,"has_org_parent":false,"code":[["org",0.0]],"binary_blob":"","custom_title":"","stable_uid":210152.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":6.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":2280,"helper_text":"","y":420,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":43264.0,"type":"MACRO_CODE","pc_address":43008.0,"height":100.0,"title":"CODE BLOCK","connected":true,"org_parent_x":2280,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; ATTACK WAVES\n; Read WAVE_SCRIPT rows. Choose path and spacing. Advance active enemies.\n; State used here:\n;   $C00D: animation clock\n;   $C024: enemy Y array\n;   $C028: enemy active flags\n;   $C040: enemy explosion timers\n\n; Enemy\n; Read WAVE_SCRIPT records: path, start X, count and spawn spacing.\n\n; Spawn from the wave table, then update each live enemy.\nEnemy:\nINC $C00D\nJSR WaveSpawn\nLDX #$00\n\n; X selects one of the four enemy slots. Skip unused slots.\nEnemyLoop:\nLDA $C028,X\nBNE EnemyActive\nJMP EnemyNext\n\n; Advance this enemy before selecting its horizontal path.\nEnemyActive:\nINC $C024,X\nLDA $C024,X\nCMP #$E8\nBCC EnemyPath\nLDA #$00\nSTA $C028,X\nJMP EnemyNext\n\n; The wave record selects straight, left, right, zigzag or sine motion.\nEnemyPath:\nINC $C02C,X\nLDA $C034,X\nBEQ EnemyStraight\nCMP #$01\nBEQ EnemyLeft\nCMP #$02\nBEQ EnemyRight\nCMP #$03\nBEQ EnemyZig\nLDA $C02C,X\nAND #$7F\nTAY\nLDA $B100,Y\nCLC\nADC $C030,X\nJMP EnemyStore\n\n; Straight waves keep their current X position.\nEnemyStraight:\nLDA $C030,X\nJMP EnemyStore\n\n; Drift left while the common update moves the enemy down.\nEnemyLeft:\nLDA $C02C,X\nLSR\nSTA $C019\nLDA $C030,X\nSEC\nSBC $C019\nJMP EnemyStore\n\n; Drift right while the common update moves the enemy down.\nEnemyRight:\nLDA $C02C,X\nLSR\nCLC\nADC $C030,X\nJMP EnemyStore\n\n; Use the phase counter to reverse horizontal direction periodically.\nEnemyZig:\nLDA $C02C,X\nAND #$3F\nCMP #$20\nBCC ZigAscending\nEOR #$3F\n\nZigAscending:\nASL\nSEC\nSBC #$1F\nCLC\nADC $C030,X\n\n; Save the chosen X position back into this enemy slot.\nEnemyStore:\nSTA $C020,X\n\n; Advance X and repeat until all four slots have been considered.\nEnemyNext:\nINX\nCPX #$04\nBEQ EnemyDone\nJMP EnemyLoop\n\nEnemyDone:\nRTS\n\n; Count down the gap between spawns; return while the timer is active.\nWaveSpawn:\nLDA $C013\nBEQ WaveReady\nDEC $C013\nRTS\n\n; Each WAVE_SCRIPT record is four bytes: path, start X, count, interval.\n; Multiply the record index by four to read the next row at $B000.\nWaveReady:\nLDA $C014\nBNE WaveFindSlot\nLDA $C012\nSTA $C007\nASL\nASL\nTAY\nLDA $B000,Y\nSTA $C016\nLDA $B001,Y\nSTA $C017\nLDA $B002,Y\nSTA $C014\nLDA $B003,Y\nSTA $C018\nINC $C012\nLDA $C012\nAND #$07\nSTA $C012\n\n; Find a free hardware-enemy slot before spawning.\nWaveFindSlot:\nLDX #$00\n\n; A slot is free only when both its enemy and explosion are inactive.\nWaveSlot:\nLDA $C028,X\nORA $C040,X\nBEQ WaveCreate\nINX\nCPX #$04\nBNE WaveSlot\nRTS\n\n; Copy the wave settings into the free slot and start it at Y=72.\n; The sprite routine chooses the user-made fade frame during entry.\nWaveCreate:\nLDA $C017\nSTA $C020,X\nSTA $C030,X\nLDA $C016\nSTA $C034,X\nLDA #$48\nSTA $C024,X\nLDA #$00\nSTA $C02C,X\nLDA #$01\nSTA $C028,X\nDEC $C014\nBEQ WavePause\nLDA $C018\nSTA $C013\nRTS\n\n; After the final enemy, leave a short pause before the next wave.\nWavePause:\nLDA #$60\nSTA $C013\n; Return through the explicit RTS node directly below this code block.\n"]],"binary_blob":"","custom_title":"","stable_uid":220038.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Enemy","scroll_alias":""},{"anim_alias":"","x":2280,"helper_text":"","y":520.0,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":43265,"type":"NORMAL","pc_address":43264,"height":60,"title":"Opcode","connected":true,"org_parent_x":2280,"org_parent_y":340,"has_org_parent":true,"code":[["rts",0]],"binary_blob":"","custom_title":"","stable_uid":271766,"wire_in_source":-1,"wire_out_target":-1,"org_uid":-1,"show_only_used":false,"code_descriptor":"Startup","scroll_alias":""},{"anim_alias":"","x":2600,"helper_text":"","y":160,"comment_w_mult":1,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":2062.0,"type":"COMMENT","pc_address":256.0,"height":100,"title":"PROJECTILE","connected":false,"org_parent_x":-1,"org_parent_y":-1,"has_org_parent":false,"code":[["Comment","Move the shot upward.\nRetire it off screen.\nHits are checked next."]],"binary_blob":"","custom_title":"PROJECTILE","stable_uid":271760,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":2600,"helper_text":"","y":340,"comment_w_mult":1.0,"x_indent":0.0,"proxy":false,"collapsed":true,"end_address":40216.0,"type":"ORG","pc_address":40192.0,"height":80.0,"title":"ORG BLOCK","connected":false,"org_parent_x":-1.0,"org_parent_y":-1.0,"has_org_parent":false,"code":[["org",0.0]],"binary_blob":"","custom_title":"","stable_uid":210171.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":7.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":2600,"helper_text":"","y":420,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":40216.0,"type":"MACRO_CODE","pc_address":40192.0,"height":100.0,"title":"CODE BLOCK","connected":true,"org_parent_x":2600,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; PROJECTILE\n; Move the shot upward. Retire it off screen. Hits are checked next.\n; State used here:\n;   $C004: shot active flag\n;   $C006: shot Y\n\n; Shot\n; Advance the player shot and retire it beyond the playfield.\n\nShot:\nLDA $C004\nBEQ ShotDone\nLDA $C006\nSEC\nSBC #$04\nSTA $C006\nCMP #$4E\nBCS ShotDone\nLDA #$00\nSTA $C004\n\nShotDone:\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":210172.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Shot","scroll_alias":""},{"anim_alias":"","x":2920,"helper_text":"","y":160,"comment_w_mult":1,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":2062.0,"type":"COMMENT","pc_address":256.0,"height":100,"title":"COLLISIONS / LIVES","connected":false,"org_parent_x":-1,"org_parent_y":-1,"has_org_parent":false,"code":[["Comment","Test shots and enemies.\nUpdate score and lives.\nStart explosion effects."]],"binary_blob":"","custom_title":"COLLISIONS / LIVES","stable_uid":271761,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":2920,"helper_text":"","y":340,"comment_w_mult":1.0,"x_indent":0.0,"proxy":false,"collapsed":true,"end_address":44189.0,"type":"ORG","pc_address":44032.0,"height":80.0,"title":"ORG BLOCK","connected":false,"org_parent_x":-1.0,"org_parent_y":-1.0,"has_org_parent":false,"code":[["org",0.0]],"binary_blob":"","custom_title":"","stable_uid":210185.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":8.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":2920,"helper_text":"","y":420,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":44189.0,"type":"MACRO_CODE","pc_address":44032.0,"height":100.0,"title":"CODE BLOCK","connected":true,"org_parent_x":2920,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; COLLISIONS / LIVES\n; Test shots and enemies. Update score and lives. Start explosion effects.\n; State used here:\n;   $C000: player X\n;   $C001: player Y\n;   $C004: shot active flag\n;   $C005: shot X\n;   $C006: shot Y\n\n; Hits\n; Resolve hits, score and lives; start the matching explosion effect.\n\n; A hit changes game state and starts effects; drawing happens later.\nHits:\nLDA $C044\nBEQ HitsAlive\nRTS\n\nHitsAlive:\nLDA $C009\nBEQ HitsStart\nDEC $C009\n\nHitsStart:\nLDX #$00\n\n; Check each active enemy against the player and the single shot.\nHitLoop:\nLDA $C028,X\nBNE HitActive\nJMP HitNext\n\nHitActive:\nLDA $C009\nBNE CheckShotHit\nLDA $C000\nSEC\nSBC $C020,X\nCLC\nADC #$0F\nCMP #$1E\nBCS CheckShotHit\nLDA $C001\nSEC\nSBC $C024,X\nCLC\nADC #$0D\nCMP #$1A\nBCS CheckShotHit\nJSR Damage\nRTS\n\n; Only an active projectile can score a hit.\nCheckShotHit:\nLDA $C004\nBEQ HitNext\nLDA $C005\nSEC\nSBC $C020,X\nCLC\nADC #$09\nCMP #$12\nBCS HitNext\nLDA $C006\nSEC\nSBC $C024,X\nCLC\nADC #$0C\nCMP #$18\nBCS HitNext\nLDA #$00\nSTA $C004\nSTA $C028,X\nLDA #$18\nSTA $C040,X\nJSR ExplosionSound\nINC $C00F\n\nHitNext:\nINX\nCPX #$04\nBEQ HitsDone\nJMP HitLoop\n\nHitsDone:\nRTS\n\n; Lose a life and start the player burst before allowing a respawn.\nDamage:\nLDA #$18\nSTA $C044\nSTA $C040,X\nLDA #$00\nSTA $C028,X\nSTA $C004\nJSR ExplosionSound\nDEC $C008\nBNE DamageDone\nLDA #$03\nSTA $C008\nLDA #$00\nSTA $C00F\n\nDamageDone:\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":220164.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Hits","scroll_alias":""},{"anim_alias":"","x":3240,"helper_text":"","y":160,"comment_w_mult":1,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":2062.0,"type":"COMMENT","pc_address":256.0,"height":100,"title":"SPRITE ANIMATION","connected":false,"org_parent_x":-1,"org_parent_y":-1,"has_org_parent":false,"code":[["Comment","Set VIC sprite registers.\nFade enemies on entry.\nShow explosion frames."]],"binary_blob":"","custom_title":"SPRITE ANIMATION","stable_uid":271762,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":3240,"helper_text":"","y":340,"comment_w_mult":1.0,"x_indent":0.0,"proxy":false,"collapsed":true,"end_address":41886.0,"type":"ORG","pc_address":41472.0,"height":80.0,"title":"ORG BLOCK","connected":false,"org_parent_x":-1.0,"org_parent_y":-1.0,"has_org_parent":false,"code":[["org",0.0]],"binary_blob":"","custom_title":"","stable_uid":210243.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":9.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":3240,"helper_text":"","y":420,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":41886.0,"type":"MACRO_CODE","pc_address":41472.0,"height":100.0,"title":"CODE BLOCK","connected":true,"org_parent_x":3240,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; SPRITE ANIMATION\n; Set VIC sprite registers. Fade enemies on entry. Show explosion frames.\n; State used here:\n;   $C000: player X\n;   $C001: player Y\n;   $C004: shot active flag\n;   $C005: shot X\n;   $C006: shot Y\n\n; DrawActors\n; Write sprite positions and pointers, including the user-made entry fade.\n\n; Convert gameplay state into VIC sprite positions, colours and pointers.\nDrawActors:\nLDA $C000\nSTA $D000\nLDA $C001\nSTA $D001\nLDA $C005\nSTA $D004\nLDA $C006\nSTA $D005\nLDA #$A5\nSTA $07FA\nLDA #$C1\nSTA $C01A\nLDA $C044\nBEQ DrawPlayerAlive\nSTA $C047\nLDA #$18\nSEC\nSBC $C047\nLSR\nLSR\nLSR\nCLC\nADC #$A6\nSTA $07F8\nLDA #$07\nSTA $D027\nJMP DrawEnemies\n\n; Select the normal player sprite when no explosion is running.\nDrawPlayerAlive:\nLDA #$01\nSTA $D027\nLDA $C00D\nLSR\nLSR\nLSR\nAND #$03\nCMP #$03\nBNE PlayerFrameReady\nLDA #$01\n\nPlayerFrameReady:\nCLC\nADC #$A0\nSTA $07F8\n\n; Each slot chooses either its explosion frame or its live enemy frame.\nDrawEnemies:\nLDA $C020\nSTA $D002\nLDA $C024\nSTA $D003\nLDA $C040\nBEQ DrawLive0\nSTA $C047\nLDA #$18\nSEC\nSBC $C047\nLSR\nLSR\nLSR\nCLC\nADC #$A6\nSTA $07F9\nLDA #$07\nSTA $D028\nJMP DrawEnable0\n\n; Enemy slot 0: frame 4 below Y=88, then the full frame 3.\nDrawLive0:\nLDA #$02\nSTA $D028\nLDA $C024\nCMP #$58\nLDA #$A3\nBCS EnemyFull0\nLDA #$A4\nCLC\n\nEnemyFull0:\nSTA $07F9\nLDA $C028\nBEQ DrawNext0\n\nDrawEnable0:\nLDA $C01A\nORA #$02\nSTA $C01A\n\nDrawNext0:\nLDA $C021\nSTA $D006\nLDA $C025\nSTA $D007\nLDA $C041\nBEQ DrawLive1\nSTA $C047\nLDA #$18\nSEC\nSBC $C047\nLSR\nLSR\nLSR\nCLC\nADC #$A6\nSTA $07FB\nLDA #$07\nSTA $D02A\nJMP DrawEnable1\n\n; Enemy slot 1: frame 4 below Y=88, then the full frame 3.\nDrawLive1:\nLDA #$02\nSTA $D02A\nLDA $C025\nCMP #$58\nLDA #$A3\nBCS EnemyFull1\nLDA #$A4\nCLC\n\nEnemyFull1:\nSTA $07FB\nLDA $C029\nBEQ DrawNext1\n\nDrawEnable1:\nLDA $C01A\nORA #$08\nSTA $C01A\n\nDrawNext1:\nLDA $C022\nSTA $D008\nLDA $C026\nSTA $D009\nLDA $C042\nBEQ DrawLive2\nSTA $C047\nLDA #$18\nSEC\nSBC $C047\nLSR\nLSR\nLSR\nCLC\nADC #$A6\nSTA $07FC\nLDA #$07\nSTA $D02B\nJMP DrawEnable2\n\n; Enemy slot 2: frame 4 below Y=88, then the full frame 3.\nDrawLive2:\nLDA #$02\nSTA $D02B\nLDA $C026\nCMP #$58\nLDA #$A3\nBCS EnemyFull2\nLDA #$A4\nCLC\n\nEnemyFull2:\nSTA $07FC\nLDA $C02A\nBEQ DrawNext2\n\nDrawEnable2:\nLDA $C01A\nORA #$10\nSTA $C01A\n\nDrawNext2:\nLDA $C023\nSTA $D00A\nLDA $C027\nSTA $D00B\nLDA $C043\nBEQ DrawLive3\nSTA $C047\nLDA #$18\nSEC\nSBC $C047\nLSR\nLSR\nLSR\nCLC\nADC #$A6\nSTA $07FD\nLDA #$07\nSTA $D02C\nJMP DrawEnable3\n\n; Enemy slot 3: frame 4 below Y=88, then the full frame 3.\nDrawLive3:\nLDA #$02\nSTA $D02C\nLDA $C027\nCMP #$58\nLDA #$A3\nBCS EnemyFull3\nLDA #$A4\nCLC\n\nEnemyFull3:\nSTA $07FD\nLDA $C02B\nBEQ DrawNext3\n\nDrawEnable3:\nLDA $C01A\nORA #$20\nSTA $C01A\n\nDrawNext3:\nLDA $C004\nBEQ EnableActors\nLDA $C01A\nORA #$04\nSTA $C01A\n\n; Write the assembled enable mask once all sprite slots are prepared.\nEnableActors:\nLDA $C01A\nSTA $D015\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":250038.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"DrawActors","scroll_alias":""},{"anim_alias":"","x":3560,"helper_text":"","y":160,"comment_w_mult":1,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":2062.0,"type":"COMMENT","pc_address":256.0,"height":100,"title":"HUD VALUES","connected":false,"org_parent_x":-1,"org_parent_y":-1,"has_org_parent":false,"code":[["Comment","Convert score to digits.\nWrite lives and score.\nThe HUD stays still."]],"binary_blob":"","custom_title":"HUD VALUES","stable_uid":271763,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":3560,"helper_text":"","y":340,"comment_w_mult":1.0,"x_indent":0.0,"proxy":false,"collapsed":true,"end_address":41004.0,"type":"ORG","pc_address":40960.0,"height":80.0,"title":"ORG BLOCK","connected":false,"org_parent_x":-1.0,"org_parent_y":-1.0,"has_org_parent":false,"code":[["org",0.0]],"binary_blob":"","custom_title":"","stable_uid":210286.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":10.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":""},{"anim_alias":"","x":3560,"helper_text":"","y":420,"comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":41004.0,"type":"MACRO_CODE","pc_address":40960.0,"height":100.0,"title":"CODE BLOCK","connected":true,"org_parent_x":3560,"org_parent_y":340,"has_org_parent":true,"code":[["code_block","; HUD VALUES\n; Convert score to digits. Write lives and score. The HUD stays still.\n; State used here:\n;   $C008: lives\n\n; Status\n; Write the current score and lives to the fixed HUD.\n\nStatus:\nLDA $C008\nCLC\nADC #$30\nSTA $0440\nLDA $C007\nCLC\nADC #$31\nSTA $044A\nLDA $C00F\nLDX #$30\n\nScoreTens:\nCMP #$0A\nBCC ScoreReady\nSEC\nSBC #$0A\nINX\nJMP ScoreTens\n\nScoreReady:\nCLC\nADC #$30\nSTA $0432\nSTX $0431\nRTS\n"]],"binary_blob":"","custom_title":"","stable_uid":210287.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Status","scroll_alias":""},{"anim_alias":"","x":3880,"helper_text":"","y":160,"comment_w_mult":1,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":2062.0,"type":"COMMENT","pc_address":25