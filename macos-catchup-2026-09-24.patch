wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"MUSIC ENTRY $A000","scroll_alias":"","anim_alias":"","helper_text":"","x_indent":0.0,"proxy":true,"collapsed":false,"end_address":40992.0,"pc_address":40960.0,"height":100.0,"title":"Code Block","connected":true,"org_parent_x":1960.0,"org_parent_y":80.0,"has_org_parent":true,"code":[["code_block","; ZYRON'S ESCAPE - MUSIC ENTRY ($A000)  - the original player ($A200 play \/ $A7D0 init) is gone,\n; the tune now lives in the ZE_MUSIC asset (Music Maker) played by the SID SONG node below.\n; ENGINE $C16B: jsr $a000 once per frame from the raster IRQ (skipped while $0344 <> 0 = paused\/dead)\n; ENGINE $C10A and GAME $C9F2: jsr $a003 to start \/ restart the tune from the top.\n    jmp sng100031_play           ; $A000  play one frame\n    jmp MUS_INIT                 ; $A003  init \/ restart\n\nMUS_INIT:\n    lda #$00                     ; song 0 (ZYRON MAIN)\n    jsr sng100031_init           ; SID SONG init: $01=$36, $D418=$0F, silence, seek row 0\n    lda #$00\n    sta $d415                    ; filter cutoff lo - the original runs the bass (voice 2)\n    lda #$07\n    sta $d416                    ; filter cutoff hi - through a heavy resonant low-pass\n    lda #$f2\n    sta $d417                    ; resonance 15, filter voice 2\n    lda #$1f\n    sta $d418                    ; volume 15 + low-pass (GAME $C9D6 writes the same after a respawn)\n    rts\n"]],"binary_blob":""},{"x":1440.0,"y":160.0,"type":"MACRO_CODE","custom_title":"","stable_uid":100018.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"TITLE $2000","scroll_alias":"","anim_alias":"","helper_text":"","x_indent":0.0,"proxy":true,"collapsed":false,"end_address":9023.0,"pc_address":8192.0,"height":100.0,"title":"Code Block","connected":true,"org_parent_x":1440.0,"org_parent_y":80.0,"has_org_parent":true,"code":[["code_block","; ZYRON'S ESCAPE - TITLE $2000  ($2000-$233E)\n; ported 1:1 from the original binary - addresses are the original ones\n;\n\n; --- TITLE SCREEN - colours, sprites (logo blocks $E9-$F2), IRQ, then wait for fire\nZ_2000:\n    lda #$08\n    sta $0286                ; KERNAL current colour\n    jsr $e544                ; KERNAL clear screen\n    ldx #$00\nZ_200A:\n    lda $2273,x              ; MADE BY text\n    sta $0527,x\n    lda #$01\n    sta $d927,x\n    inx\n    cpx #$07\n    bne Z_200A\n    lda #$0b\n    sta $d021                ; background\n    sta $d020                ; border\n    lda #$0f\n    sta $d023                ; multicolour 2\n    lda #$0c\n    sta $d022                ; multicolour 1\n    lda #$3f\n    sta $d01c                ; sprite multicolour\n    sta $d01d                ; sprite X expand\n    lda #$06\n    ldx #$00\nZ_2038:\n    sta $d027,x              ; sprite 0 colour\n    inx\n    cpx #$08\n    bne Z_2038\n    lda #$20\n    sta $d010                ; sprite X msb\n    lda #$0e\n    sta $d026                ; sprite MC 2\n    lda #$0b\n    sta $d025                ; sprite MC 1\n    lda #$2e\n    ldx #$00\nZ_2053:\n    sta $d000,x              ; sprite 0 X\n    clc\n    adc #$2e\n    inx\n    inx\n    cpx #$10\n    bne Z_2053\n    lda #$b7\n    sta $02a8                ; title fine-scroll ($D016 shadow)\n    lda #$0b\n    sta $0340                ; title sprite colour table (6)\n    lda #$0c\n    sta $0341\n    lda #$0f\n    sta $0342\n    lda #$01\n    sta $0343\n    lda #$0f\n    sta $0344                ; player frozen flag (death anim)\n    lda #$0c\n    sta $0345\n    lda #$00\n    sta $0346                ; title colour index\n    sta $0347                ; title timer lo\n    lda #$ff\n    sta $02a9                ; title scroll column index\n    sei\n    lda #$b2\n    sta $0314                ; IRQ vector lo\n    lda #$20\n    sta $0315                ; IRQ vector hi\n    lda #$7f\n    sta $dc0d                ; CIA1 IRQ control\n    lda #$01\n    sta $d01a                ; VIC IRQ mask\n    lda #$1b\n    sta $d011                ; VIC control 1\n    lda #$00\n    sta $d012                ; raster\n    cli\n    jmp Z_2161\n\n; --- TITLE IRQ - three raster zones: 0 (charset $1000, logo sprites), $4E (second sprite row), $72 (scroll text)\nZ_20B2:\n    lda $d019                ; VIC IRQ flags\n    sta $d019                ; VIC IRQ flags\n    lda $d012                ; raster\n    cmp #$00\n    beq Z_20CA\n    cmp #$4e\n    beq Z_2117\n    cmp #$72\n    beq Z_2114\n    jmp Z_219A\nZ_20CA:\n    lda #$c7\n    sta $d016                ; VIC control 2\n    lda #$4e\n    sta $d012                ; raster\n    lda #$15\n    sta $d018                ; VIC memory ptrs\n    lda #$04\n    sta $d021                ; background\n    sta $d020                ; border\n    lda #$3f\n    sta $d015                ; sprite enable\n    lda #$e9\n    sta $07f8                ; sprite 0 pointer (player)\n    lda #$ea\n    sta $07f9                ; sprite 1-7 pointers (enemies)\n    lda #$eb\n    sta $07fa\n    lda #$ec\n    sta $07fb\n    lda #$ed\n    sta $07fc\n    lda #$ee\n    sta $07fd\n    ldx #$01\n    lda #$34\nZ_2108:\n    sta $d000,x              ; sprite 0 X\n    inx\n    inx\n    cpx #$11\n    bne Z_2108\n    jmp Z_219A\nZ_2114:\n    jmp Z_21BE\nZ_2117:\n    lda #$72\n    sta $d012                ; raster\n    lda #$c7\n    sta $d016                ; VIC control 2\n    lda #$0a\n    sta $d021                ; background\n    sta $d020                ; border\n    lda #$15\n    sta $d018                ; VIC memory ptrs\n    lda #$3f\n    sta $d015                ; sprite enable\n    lda #$ef\n    sta $07f8                ; sprite 0 pointer (player)\n    lda #$ee\n    sta $07f9                ; sprite 1-7 pointers (enemies)\n    lda #$f0\n    sta $07fa\n    lda #$f1\n    sta $07fb\n    lda #$f2\n    sta $07fc\n    lda #$ef\n    sta $07fd\n    ldx #$01\n    lda #$53\nZ_2155:\n    sta $d000,x              ; sprite 0 X\n    inx\n    inx\n    cpx #$11\n    bn